# Mounting bracket: 100 x 60 x 10 mm plate, two 10 mm through-holes, 16 mm boss.
# Build:  python3 brl.py build bracket.mged -o bracket.g --fresh
units mm
title Mounting bracket

# Primitives: one solid per feature, named <part>-<feature>.<type>
in plate.rpp rpp 0 100 0 60 0 10
# Cutters run 1 mm past both faces so the holes go cleanly through.
in hole1.rcc rcc 15 30 -1 0 0 12 5
in hole2.rcc rcc 85 30 -1 0 0 12 5
in boss.rcc  rcc 50 30 10 0 0 15 8
in bore.rcc  rcc 50 30 -1 0 0 27 4

# One region = one homogeneous solid part. Operators bind left to right inside
# each `u` term: u A - B - C  u D - E   is   (A-B-C) ∪ (D-E)
r bracket.r u plate.rpp - hole1.rcc - hole2.rcc - bore.rcc u boss.rcc - bore.rcc

# shader R G B inherit
mater bracket.r plastic 200 40 40 0
# material_id indexes the density table used by `brl.py mass --density`
attr set bracket.r material_id 3

g bracket bracket.r
